# Copy to .env.local and fill in. Leave both Supabase values empty to run the
# app fully on-device (no accounts, no payments), as in local demos.

# Supabase project URL (Project Settings -> API), e.g. https://abcd1234.supabase.co
VITE_SUPABASE_URL=
# Publishable (anon) key. Safe to ship in the browser: row-level security
# protects the data. Never put the service-role key or any secret here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. 1 = use the in-memory demo backend (fake sign-in with any 6-digit
# code, fake checkout, sample visuals, demo KPIs). Overrides the values above.
# Sign in as admin@... for the dashboard or reviewer@... for the review console.
VITE_BACKEND_MOCK=

# Optional. KWD per 1 USD / 1 EUR, used to show image costs and ad spend in KWD
# on the dashboard. Defaults are approximate; use your accountant's rate.
VITE_FX_USD_KWD=
VITE_FX_EUR_KWD=
