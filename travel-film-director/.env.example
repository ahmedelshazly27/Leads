# Copy to .env (never commit it). All keys are optional.
# Enables Claude-powered qualitative analysis + "ask" answers.
ANTHROPIC_API_KEY=
# Model used for Claude calls (default claude-opus-5-5).
TFD_CLAUDE_MODEL=claude-opus-5-5
# Where the reference library, projects and caches live (default ./data).
TFD_DATA_DIR=
# Optional: Netscape cookies.txt exported from YOUR browser if YouTube asks to "confirm you're not a bot".
TFD_YT_COOKIES=
# Optional: use cookies straight from a local browser profile, e.g. "firefox" or "chrome".
TFD_YT_COOKIES_FROM_BROWSER=
# Optional free stock footage keys for `tfd stock` (Pexels: https://www.pexels.com/api/, Pixabay: https://pixabay.com/api/docs/)
PEXELS_API_KEY=
PIXABAY_API_KEY=
